# ---------------------------------------------------------------------------
# TradeX API — copy to .env and fill in. Nothing here is a real secret.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS (comma-separated for several).
# Must match where the client actually runs, or the browser will block requests.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
#
# The trading engine uses multi-document transactions, which MongoDB only
# supports on a REPLICA SET. A standalone mongod accepts the connection but
# every trade then fails with "Transaction numbers are only allowed on a
# replica set member or mongos".
#
# Either use the bundled docker-compose (already a replica set), or run one
# locally with:  mongod --replSet rs0   then   mongosh --eval "rs.initiate()"
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/tradex?replicaSet=rs0

# ---------------------------------------------------------------------------
# Auth — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# ---------------------------------------------------------------------------
# Trading
# ---------------------------------------------------------------------------
STARTING_CASH=100000
TRADE_FEE_RATE=0.0005

# ---------------------------------------------------------------------------
# Market data
#
# MARKET_DATA_PROVIDER: auto | fyers | finnhub | mock
#   auto (default)  uses whatever credentials are configured, falling back to
#                   the offline simulator, so a fresh clone runs immediately.
#   mock            forces the offline simulator (no credentials needed).
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=auto
QUOTE_CACHE_TTL_SECONDS=5
CANDLE_CACHE_TTL_SECONDS=300
STALE_PRICE_TTL_SECONDS=86400
MARKET_DATA_TIMEOUT_MS=5000
MARKET_DATA_POLL_INTERVAL_MS=15000


# Fallback data provider (free tier, no broker account needed)
FINNHUB_API_KEY=

# Optional shared cache. The in-memory TTL cache is used when this is unset.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_TRADE_MAX=60
RATE_LIMIT_GENERAL_MAX=300

# ---------------------------------------------------------------------------
# Scheduled jobs — set ENABLE_JOBS=false to run the API without cron
# ---------------------------------------------------------------------------
ENABLE_JOBS=true
ORDER_RESOLVE_CRON=*/10 * * * * *
ALERT_CHECK_CRON=*/30 * * * * *
LEADERBOARD_CRON=*/5 * * * *

# ---------------------------------------------------------------------------
# Alert notifications. Without SMTP the alert is logged instead of emailed.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TradeX <no-reply@tradex.local>

# ---------------------------------------------------------------------------
# Admin / seeding
# ---------------------------------------------------------------------------
ANOMALY_TRADE_THRESHOLD=50
SEED_PASSWORD=Passw0rdDemo
